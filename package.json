{
  "name": "northline-erp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "dev:db": "docker start northline-pg 2>/dev/null || docker run -d --name northline-pg -e POSTGRES_PASSWORD=northline -e POSTGRES_DB=northline -p 55432:5432 postgres:17-alpine",
    "dev:api": "bun --watch apps/api/src/main.ts --role=all",
    "seed": "bun apps/api/scripts/seed.ts",
    "e2e": "node tools/e2e/n1-flows.mjs",
    "deploy:prod": "bun apps/api/scripts/deploy-prod.ts",
    "switch:prod": "bun apps/api/scripts/switch-prod.ts",
    "loop": "tools/loop/loop.sh"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
