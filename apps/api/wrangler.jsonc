// Cloudflare Workers deploy (ADR-0017). Secret: DATABASE_URL (Neon pooled URL) via `wrangler secret put DATABASE_URL`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "northline-erp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": { "NODE_ENV": "production" },
  // logs only, sampled: traces and full logging eat into the free-tier observability quota
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "traces": { "enabled": false } }
}
