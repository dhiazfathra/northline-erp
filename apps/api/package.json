{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts --role=all",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.types.json",
    "build": "pnpm --filter web build && bun scripts/embed-spa.ts && bun build src/main.ts --compile --outfile dist/northline-api && git checkout src/spa.generated.ts",
    "create-user": "bun src/main.ts create-user",
    "types": "tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "@northline/schemas": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "~7.0.2"
  }
}
